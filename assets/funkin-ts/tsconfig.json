{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "funkin/*": [
        "src/funkin/*"
      ],
      "flixel/*": [
        "src/flixel/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}